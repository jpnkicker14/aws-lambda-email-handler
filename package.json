{
  "name": "aws-lambda-ses-mailer",
  "version": "3.0.0",
  "description": "Reusable AWS Lambda email handler with SES and reCAPTCHA verification",
  "type": "module",
  "main": "./dist/sendMailHandler.js",
  "types": "./dist/sendMailHandler.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sendMailHandler.d.ts",
      "import": "./dist/sendMailHandler.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1176.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "busboy": "^1.6.0",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/busboy": "^1.5.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.9",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
