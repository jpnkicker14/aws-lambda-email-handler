{
  "compilerOptions": {
    /* Output structure */
    "rootDir": "src",
    "outDir": "dist",
    /* Target modern Node (Lambda supports Node 18+) */
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* Type definitions */
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "declaration": true,
    /* No declarationMap: it only points "go to definition" at src/*.ts, which
       is not published, so for consumers it is a dangling file. */
    "sourceMap": true,
    /* Embed sources in the maps: src/ is not published, so without this the
       shipped maps point at files the package does not contain. */
    "inlineSources": true,
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    /* Module hygiene */
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUncheckedSideEffectImports": true,
    /* Compatibility */
    "esModuleInterop": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts"
  ]
}